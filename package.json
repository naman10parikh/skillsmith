{
  "name": "@energy/skillsmith",
  "version": "1.0.0",
  "description": "Create, test and vet SKILL.md skills for any coding agent.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "skillsmith": "dist/index.js",
    "skillsmith-mcp": "dist/mcp/server.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./mcp": {
      "import": "./dist/mcp/server.js",
      "types": "./dist/mcp/server.d.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    ".claude-plugin"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "dev": "tsx src/index.ts",
    "start": "tsx src/index.ts",
    "mcp": "node dist/mcp/server.js",
    "mcp:dev": "tsx src/mcp/server.ts",
    "test": "vitest run",
    "eval": "vitest run --config eval/vitest.config.ts",
    "improve": "node scripts/improve.mjs",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm run build && npm run test"
  },
  "keywords": [
    "claude-code",
    "ai-agent",
    "skills",
    "registry",
    "harness",
    "developer-tools",
    "cli",
    "scaffold",
    "anthropic",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/naman10parikh/skillsmith"
  },
  "homepage": "https://github.com/naman10parikh/skillsmith#readme",
  "bugs": {
    "url": "https://github.com/naman10parikh/skillsmith/issues"
  },
  "author": "Naman Parikh",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.3.2",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "e2b": "^2.56.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
